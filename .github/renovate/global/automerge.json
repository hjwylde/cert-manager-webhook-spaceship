{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "constraintsFiltering": "strict",
  "digest": {
    "automerge": true,
    "automergeType": "branch",
    "ignoreTests": true
  },
  "pinDigest": {
    "automerge": true,
    "automergeType": "branch",
    "ignoreTests": true
  }
}
